# Copy to .env.local and fill in. Never commit real secrets — .env files are gitignored.

# Public canonical site URL (used for SEO: metadata, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://oridorjewelry.com

# --- Shopify Storefront (public; safe to expose to the browser) ---
# The Storefront API endpoint runs on the myshopify.com domain (most reliable).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# OPTIONAL branded checkout domain. Leave EMPTY (default) to use Shopify's
# native secure-checkout URL — the actual checkout domain is set by the store's
# primary domain in Shopify Admin (Settings → Domains), not by this app. Set a
# value here only if you add a dedicated branded checkout domain and want every
# checkout URL pinned to it.
NEXT_PUBLIC_SHOPIFY_CHECKOUT_DOMAIN=

# VIP club welcome discount code. Joining the club applies THIS code to the
# shopper's cart for an instant 10% off. It MUST exist in Shopify: Discounts →
# Create discount → Discount code → 10% off, code = the value below. Defaults to
# "WELCOME10" if unset. Until a matching code exists in Shopify, it's stored on
# the cart but not applied (discountCodes[].applicable = false).
NEXT_PUBLIC_CLUB_WELCOME_CODE=WELCOME10

# --- Server-only secrets: never prefix these with NEXT_PUBLIC_ ---
# Admin API access token. Needs the `write_customers` scope so the promo popup's
# /api/lead route can save captured emails/phones as Shopify customers with
# email-marketing consent. Create it in Shopify Admin → Settings → Apps and sales
# channels → Develop apps → (your app) → API credentials. Until this is set,
# leads are validated and logged but NOT persisted.
# SHOPIFY_ADMIN_API_ACCESS_TOKEN=
